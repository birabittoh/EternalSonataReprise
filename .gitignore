# Visual Studio / IDE droppings
.vs/
.vscode/
EternalSonataReprise.code-workspace

# Build output
/out/
*.pdb
*.ilk
*.exp
*.lib
*.exe

# rexglue migration backups
CMakeLists.txt.bak
src/main.cpp.bak

# Generated recomp sources
/generated/

# Runtime artifacts — binary, logs, and bundled shared libraries
/sdk/
/logs/
/eternalsonata
/eternalsonata.exe
/eternalsonata.pdb
/eternalsonata.toml
# The native renderer's shader pack, rebuilt from assets/default.xex by
# scripts/gen-guest-shaders.py (see src/guest_shaders.h)
guest_shaders.bin
guest_shaders_debug.bin
/*.so
/*.dll
/*.rdc
/*.cap

# Embedded icon header/ico, rebuilt from assets/default.xex by scripts/gen-icon.py
/src/icon.generated.h
/src/icon.generated.ico
/src/version.generated.h.in

# Area-name table for the Discord presence, rebuilt from docs/cfdata_names.txt
# by scripts/gen-area-names.py
/src/area_names.generated.h

# Embedded overlay font, rebuilt from src/fonts/*.ttf by scripts/gen-fonts.py
/src/fonts.generated.h

# Windows exe-icon resource script, rewritten by CMake with an absolute path
# to src/icon.generated.ico (see CMakeLists.txt)
/src/eternalsonata.generated.rc

# Game assets extracted from the user's ISO
# (the ISO itself and anything derived from it must NEVER be committed)
/*.iso
/assets/
!/assets/.gitkeep
/out/iso_extract/
*.vert
*.frag
dumps/

# Third-party tools dropped by the user locally.
# Ignore the tree, but keep the scripts and README we wrote.
/tools/*
!/tools/README.md
!/tools/*.ps1

# Locally built libraries
/local/

CLAUDE.md
opencode.json
.mcp.json
.kiro/

# Extracted/decoded assets (regenerate with scripts/unpack_e.exe)
/extracted/
/repacked/
__pycache__/

# Mods
/mods/

# DLC content packages (STFS containers dropped in by the user; see
# src/dlc_auto_install.cpp)
/dlc/

# IDA working files (created alongside .i64 when a database is open)
*.id0
*.id1
*.id2
*.nam
*.til

# Android build artifacts (Gradle output, staged JNI libs, staged assets)
/android/.gradle/
/android/app/build/
/android/app/jniLibs/
/android/app/assets/
/android/build/
/android/local.properties
# Generated launcher icons (rebuilt from assets/default.xex by scripts/gen-android-icon.py)
/android/app/src/main/res/mipmap-mdpi/
/android/app/src/main/res/mipmap-hdpi/
/android/app/src/main/res/mipmap-xhdpi/
/android/app/src/main/res/mipmap-xxhdpi/
/android/app/src/main/res/mipmap-xxxhdpi/
